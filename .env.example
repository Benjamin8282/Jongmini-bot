# ── 디스코드 봇 ──
DISCORD_TOKEN=
GUILD_ID=

# ── DNF 오픈 API ──
NEOPLE_API_KEY=

# ── 자캐 AI 커미션 (선택) ──
# true 일 때만 /자캐커미션 커맨드가 등록된다(기본 비활성).
# 활성화하려면 AWS 자격증명(~/.aws/credentials 또는 표준 체인)과
# bedrock:InvokeModel 권한이 필요하다.
BEDROCK_COMMISSION_ENABLED=false

# 모델/리전 override (선택 — 미설정 시 코드 기본값 사용)
# BEDROCK_DESCRIBE_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# BEDROCK_DESCRIBE_REGION=us-east-1
# BEDROCK_IMAGE_MODEL_ID=stability.stable-image-ultra-v1:1
# BEDROCK_IMAGE_REGION=us-west-2
